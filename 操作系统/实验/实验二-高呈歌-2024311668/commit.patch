diff --git a/kernel/sysproc.c b/kernel/sysproc.c
index a69071e..8177cb0 100644
--- a/kernel/sysproc.c
+++ b/kernel/sysproc.c
@@ -7,6 +7,8 @@
 #include "spinlock.h"
 #include "proc.h"
 
+extern struct proc proc[NPROC];
+
 uint64 sys_exit(void) {
   int n;
   if (argint(0, &n) < 0) return -1;
@@ -20,8 +22,15 @@ uint64 sys_fork(void) { return fork(); }
 
 uint64 sys_wait(void) {
   uint64 p;
-  if (argaddr(0, &p) < 0) return -1;
-  return wait(p);
+  int flags;
+
+  if (argaddr(0, &p) < 0)
+    return -1;
+
+  if (argint(1, &flags) < 0)
+    return -1;
+
+  return wait(p, flags);
 }
 
 uint64 sys_sbrk(void) {
@@ -81,3 +90,41 @@ uint64 sys_rename(void) {
   p->name[len] = '\0';
   return 0;
 }
+
+// Lab2 Task 3: yield system call.
+uint64
+sys_yield(void)
+{
+  struct proc *p = myproc();
+
+  // 1. Print the address range of the kernel context.
+  printf("Save the context of the process to the memory region from address %p to %p\n",
+         (uint64)&p->context,
+         (uint64)(&p->context + 1));
+
+  // 2. Print current PID and user PC.
+  printf("Current running process pid is %d and user pc is %p\n",
+         p->pid,
+         p->trapframe->epc);
+
+  // 3. Find the next runnable process.
+  for (struct proc *np = proc; np < &proc[NPROC]; np++) {
+    acquire(&np->lock);
+
+    if (np->state == RUNNABLE) {
+      printf("Next runnable process pid is %d and user pc is %p\n",
+             np->pid,
+             np->trapframe->epc);
+
+      release(&np->lock);
+      break;
+    }
+
+    release(&np->lock);
+  }
+
+  // 4. Give up the CPU.
+  yield();
+
+  return 0;
+}
